 badge(s,'REPEATABLE',1.08,5.92,1.35,{fill:'173A54',color:C.cyan,fs:8.4}); badge(s,'FROZEN',2.65,5.92,1.10,{fill:'251D43',color:'CFC1FF',fs:8.4}); badge(s,'NOT DEPLOYED',4.00,5.92,1.58,{fill:'3A281D',color:'FFC494',fs:8.4});
 s.addText('工程价值：把 AI 预测、储能约束、决策评价连成一条可审计链。',{x:6.05,y:5.94,w:5.92,h:.30,fontFace:FF,fontSize:12,bold:true,color:'B5C6D3',margin:0});
