const IMG=n=>path.join(ROOT,ASSET_MAP[n]);
function addTop(slide, id, section, light=false){
  slide.addText(id,{x:.48,y:.21,w:.72,h:.22,fontFace:EN,fontSize:8.5,bold:true,color:light?C.validation:C.cyan,charSpacing:1.3,margin:0});
  slide.addText(section.toUpperCase(),{x:1.25,y:.21,w:3.2,h:.22,fontFace:EN,fontSize:8.3,bold:true,color:light?'7A8897':'7890A7',charSpacing:1.0,margin:0});
}
function title(slide,text,{dark=false,size=27,y=.52,w=12.1}={}){
  slide.addText(text,{x:.62,y,w,h:.62,fontFace:FF,fontSize:size,bold:true,color:dark?C.white:C.ink,margin:0,breakLine:false,fit:'shrink'});
}
function subtitle(slide,text,{dark=false,y=1.18,w=11.7}={}){
  slide.addText(text,{x:.64,y,w,h:.4,fontFace:FF,fontSize:12.4,color:dark?'9DB0C2':C.muted,margin:0,fit:'shrink'});
}
function footer(slide,text,{dark=false}={}){
  slide.addText(text,{x:.62,y:7.04,w:11.3,h:.18,fontFace:FF,fontSize:7.5,color:dark?'6F8295':'8996A4',margin:0,fit:'shrink'});
}
function source(slide,text,{dark=false}={}){
  slide.addText(text,{x:.62,y:6.73,w:11.75,h:.16,fontFace:EN,fontSize:6.7,color:dark?'597087':'97A2AD',margin:0,fit:'shrink'});
}
function badge(slide,text,x,y,w,{fill=C.blue,color='FFFFFF',line=fill,fs=9}={}){
  slide.addShape(pptx.ShapeType.roundRect,{x,y,w,h:.32,rectRadius:.06,fill:{color:fill},line:{color:line,transparency:100}});
  slide.addText(text,{x:x+.08,y:y+.045,w:w-.16,h:.20,fontFace:FF,fontSize:fs,bold:true,color,align:'center',margin:0,fit:'shrink'});
}
function card(slide,x,y,w,h,{fill='FFFFFF',line='E0E7EF',radius=.09,sh=undefined}={}){
  const shape = {x,y,w,h,rectRadius:radius,fill:{color:fill},line:{color:line,width:.8}};
  if (sh !== null) shape.shadow = sh ?? safeOuterShadow('000000',0.16,45,1.5,1.1);
  slide.addShape(pptx.ShapeType.roundRect,shape);
}
function addImageCard(slide,img,x,y,w,h,{pad=.12}={}){
  card(slide,x,y,w,h,{fill:'FFFFFF',line:'E2E8F0'});
  slide.addImage({path:img,...imageSizingContain(img,x+pad,y+pad,w-pad*2,h-pad*2)});
}
function lineArrow(slide,x1,y1,x2,y2,{color=C.cyan,width=2,dash='solid'}={}){
  slide.addShape(pptx.ShapeType.line,{x:x1,y:y1,w:x2-x1,h:y2-y1,line:{color,width,dashType:dash,beginArrowType:'none',endArrowType:'triangle'}});
}
function bigNumber(slide,n,label,x,y,w,{accent=C.blue,dark=false}={}){
  slide.addText(n,{x,y,w,h:.62,fontFace:EN,fontSize:28,bold:true,color:accent,margin:0,fit:'shrink'});
  slide.addText(label,{x,y:y+.72,w,h:.42,fontFace:FF,fontSize:11.5,color:dark?'A9B8C6':C.muted,margin:0,fit:'shrink'});
}
function note(slide,txt){ try{ slide.addNotes(txt); }catch(e){} }
function mainFooter(slide, id, dark=false){ footer(slide,`${id} · 固定 8 栋办公建筑 · Validation 选规则 · Test 仅评估`,{dark}); }
function appHeader(slide,id,role){ addTop(slide,id,`APPENDIX · ${role}`,true); badge(slide,'Q&A ONLY',11.55,.19,.98,{fill:C.validation,fs:8.2}); }

