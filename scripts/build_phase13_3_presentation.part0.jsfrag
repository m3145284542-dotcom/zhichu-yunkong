  blue:'1677FF', cyan:'24C7FF', doef:'0072B2', lgbm:'D55E00', xgb:'009E73', dayweek:'CC79A7', validation:'6F4E9C', test:'67727C', orange:'E69F00', red:'B35C00', green:'18A76C', lightBlue:'E9F5FF', lightPurple:'F0EBFA', lightOrange:'FFF1E8'
};
const FF='Microsoft YaHei';
const EN='Arial';
const ROOT=path.resolve(__dirname,'..');
const ASSET_MAP={
  sci_01_forecast_decision_mismatch:'outputs/phase13_1/figures/sci_01_forecast_decision_mismatch.png',
  sci_02_doef_main_results:'outputs/phase13_1/figures/sci_02_doef_main_results.png',
