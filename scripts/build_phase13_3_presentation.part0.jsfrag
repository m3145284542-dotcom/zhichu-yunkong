 s.addText('全球人工智能算法精英大赛 · AI+能源主题赛',{x:.68,y:6.55,w:4.1,h:.25,fontFace:FF,fontSize:8.2,color:'647B90',margin:0});
 mainFooter(s,'SB-M01',true);
