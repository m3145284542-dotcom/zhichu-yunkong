const pptxgen = require('pptxgenjs');
const path = require('path');
const fs = require('fs');
const { imageSize } = require('image-size');

function imageSizingContain(img, x, y, w, h) {
  const dim = imageSize(fs.readFileSync(img));
  const scale = Math.min(w / dim.width, h / dim.height);
  const iw = dim.width * scale, ih = dim.height * scale;
  return { x: x + (w-iw)/2, y: y + (h-ih)/2, w: iw, h: ih };
}
function safeOuterShadow(color='000000', opacity=.16, angle=45, blur=1.5, distance=1.1) {
  return { type:'outer', color, opacity, angle, blur, distance };
}

const pptx = new pptxgen();
pptx.layout = 'LAYOUT_WIDE'; // 13.333 × 7.5
pptx.author = 'OpenAI · Phase 13.3 presentation production';
pptx.subject = 'DOEF competition defense deck based on frozen Phase 13.2 storyboard';
pptx.title = 'DOEF：让负荷预测服务于储能削峰决策';
pptx.company = 'Competition presentation';
pptx.lang = 'zh-CN';
pptx.theme = {
  headFontFace: 'Microsoft YaHei',
  bodyFontFace: 'Microsoft YaHei',
  lang: 'zh-CN'
};
pptx.defineSlideMaster({
  title: 'MAIN_DARK',
  background: { color: '07111E' },
  objects: [
    { rect: { x:0, y:0, w:13.333, h:0.06, fill:{color:'24C7FF'}, line:{color:'24C7FF'} } },
  ],
  slideNumber: { x:12.55, y:7.05, w:0.45, h:0.18, color:'6F8295', fontFace:'Arial', fontSize:8, align:'right' }
});
pptx.defineSlideMaster({
  title: 'MAIN_LIGHT',
  background: { color: 'F7FAFC' },
  objects: [
    { rect: { x:0, y:0, w:13.333, h:0.06, fill:{color:'1677FF'}, line:{color:'1677FF'} } },
  ],
  slideNumber: { x:12.55, y:7.05, w:0.45, h:0.18, color:'8A98A8', fontFace:'Arial', fontSize:8, align:'right' }
});
pptx.defineSlideMaster({
  title: 'APPENDIX',
  background: { color: 'FAFBFC' },
  objects: [
    { rect: { x:0, y:0, w:13.333, h:0.06, fill:{color:'6F4E9C'}, line:{color:'6F4E9C'} } },
  ],
