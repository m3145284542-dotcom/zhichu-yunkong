 s.addText('“这次预测让调度损失了多少？”',{x:7.45,y:3.29,w:4.2,h:.38,fontFace:FF,fontSize:15.2,bold:true,color:C.white,margin:0,fit:'shrink'});
 s.addText('预测 → 电池优化 → 实际负荷，\n再与不可部署 Oracle 的最优决策结果比较。',{x:7.45,y:3.90,w:4.20,h:1.05,fontFace:FF,fontSize:12,color:'A5B7C6',margin:0,fit:'shrink'});
 lineArrow(s,6.34,4.82,6.98,4.82,{color:'566F85',width:2});
