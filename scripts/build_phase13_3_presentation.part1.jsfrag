 s.addText('所有预测方法进入同一套冻结电池约束，保证比较的是“预测带来的决策差异”，不是不同优化器。',{x:3.58,y:6.13,w:8.45,h:.32,fontFace:FF,fontSize:10.8,color:'A9B9C8',margin:0,fit:'shrink'});
 source(s,'Conceptual asset: outputs/phase13_1/presentation_assets/con_01_prediction_decision_bridge.png',{dark:true}); mainFooter(s,'SB-M03',true);
 note(s,'让 AI 与电气评委建立共同心智模型：历史负荷→次日预测→受约束电池调度→真实削峰结果。概念图不是实验结果。过渡：既然下游目标不同，模型选择标准也要重新对齐。');
}

// M04
{
