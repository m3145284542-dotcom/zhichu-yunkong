 s.addText('“预测偏了多少？”',{x:1.13,y:3.29,w:3.9,h:.38,fontFace:FF,fontSize:16,bold:true,color:C.white,margin:0});
 s.addText('对所有时间点的误差做平方惩罚并聚合。\n它是必要的预测质量检查，但不是储能决策本身。',{x:1.13,y:3.90,w:4.25,h:1.15,fontFace:FF,fontSize:12,color:'A5B7C6',margin:0,breakLine:false,fit:'shrink'});
