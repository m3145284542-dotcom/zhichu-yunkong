     if(i<n-1) lineArrow(s,x+bw+.04,r.y+.18,x+bw+gap-.03,r.y+.18,{color:i===n-2?r.accent:'466078',width:1.5});
   });
   s.addText(r.last,{x:10.55,y:r.y+.72,w:1.55,h:.28,fontFace:FF,fontSize:9.5,bold:true,color:r.accent,align:'right',margin:0});
 }
 s.addShape(pptx.ShapeType.line,{x:1.1,y:3.57,w:11.1,h:0,line:{color:'234057',width:1,dash:'dash'}});
 badge(s,'唯一强调的改变：SELECTION OBJECTIVE',4.33,6.02,4.70,{fill:'251D43',color:'D9CCFF',line:'5F45A8',fs:10.2});
 s.addText('不是联合训练 · 不是新基础模型 · 不是用 Test 调权重',{x:3.48,y:6.48,w:6.25,h:.32,fontFace:FF,fontSize:10.2,color:'8298AA',align:'center',margin:0});
 mainFooter(s,'SB-M04',true);
 note(s,'这一页只讲一个改变：selection criterion。组件预测不变，电池约束不变。DOEF 不是联合训练、双层优化或新的 LightGBM。下一页给完整冻结信息流。');
}

