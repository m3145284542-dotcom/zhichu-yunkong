 source(s,'Frozen method visual: outputs/phase13_1/architecture/doef_architecture_master.png · formula: wᵦ·LightGBM + (1−wᵦ)·DayWeek'); mainFooter(s,'SB-M05');
 note(s,'算法只解释一次。强调三段：Train 拟合组件；Validation 把候选权重送入同一电池优化，以 mean daily regret 选择并冻结；Test 只报告。Oracle 只作不可部署 hindsight 上界。');
}

